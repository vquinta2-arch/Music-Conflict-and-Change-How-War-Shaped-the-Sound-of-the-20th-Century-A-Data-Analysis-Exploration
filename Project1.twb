      <aliases enabled='yes' />
      <column caption='Vocalness' datatype='real' name='[Calculation_1109793230233602]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1 - [instrumentalness]' />
      </column>
      <column caption='Historical Era WWII Korean War and Vietnam' datatype='string' name='[Calculation_1109793232089091]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [year] &gt;= 1939 AND [year] &lt;= 1945 THEN &quot;WWII (1939-1945)&quot;&#10;ELSEIF [year] &gt;= 1950 AND [year] &lt;= 1953 THEN &quot;Korean War (1950-1953)&quot;&#10;ELSEIF [year] &gt;= 1964 AND [year] &lt;= 1973 THEN &quot;Vietnam War (1964-1973)&quot;&#10;END' />
      </column>
      <column caption='Historical Era' datatype='string' name='[Calculation_4019443171782656]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [year] &lt;= 1938 THEN &quot;1. Pre-War (1936-1938)&quot;&#10;ELSEIF [year] &lt;= 1945 THEN &quot;2. Wartime (1939-1945)&quot;&#10;ELSE &quot;3. Post-War (1946-1951)&quot;&#10;END' />
      </column>
      <column caption='First Value for AVG Valence' datatype='real' name='[Calculation_5099988125995010]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// First Point AVG(Valence)&#10;{ FIXED : AVG(IF [year] = 1936 THEN [valence] END) }' />
      </column>
      <column caption='Last Value for AVG(Valence)' datatype='real' name='[Calculation_5099988126900227]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Last Point AVG(Valence)&#10;{ FIXED : AVG(IF [year] = 1951 THEN [valence] END) }' />
      </column>
      <column caption='Difference First value Last value AVG(Valence)' datatype='real' name='[Calculation_5099988126969860]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5099988126900227] - [Calculation_5099988125995010]' />
      </column>
      <column caption='First Value for Energy' datatype='real' name='[Calculation_5099988128595974]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// First Point AVG(Energy)&#10;{ FIXED : AVG(IF [year] = 1936 THEN [energy] END) }' />
      </column>
      <column caption='Last Value For Energy' datatype='real' name='[Calculation_5099988128722951]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Last Point AVG(Energy)&#10;{ FIXED : AVG(IF [year] = 1951 THEN [energy] END) }' />
      </column>
      <column caption='Difference Energy' datatype='real' name='[Calculation_5099988128829448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5099988128722951] - [Calculation_5099988128595974]' />
      </column>
      <column caption='Percent Change Since 1936 - Valence' datatype='real' default-format='p0.00%' name='[Calculation_5099988131168265]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_5099988126900227] - [Calculation_5099988125995010]) / [Calculation_5099988125995010]' />
      </column>
      <column caption='Percent Change Since 1936 Energy' datatype='real' default-format='p0.00%' name='[Calculation_5099988131491850]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_5099988128722951] - [Calculation_5099988128595974]) / [Calculation_5099988128595974]' />
      </column>
