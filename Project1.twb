    <worksheet name='Acousticness vs Vocalness Over Different Wars'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='34'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='spotify_tracks' name='federated.1ib422m0y1w42f1228iq00oxiq4i' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Start Korean War' datatype='real' name='[Parameter 1109793234456582]' param-domain-type='any' role='measure' type='quantitative' value='1950.'>
              <calculation class='tableau' formula='1950.' />
            </column>
            <column caption='End Korean War' datatype='real' name='[Parameter 1109793234501639]' param-domain-type='any' role='measure' type='quantitative' value='1953.'>
              <calculation class='tableau' formula='1953.' />
            </column>
            <column caption='Start Vietnam War' datatype='real' name='[Parameter 1109793234636808]' param-domain-type='any' role='measure' type='quantitative' value='1964.'>
              <calculation class='tableau' formula='1964.' />
            </column>
            <column caption='End Vietnam War' datatype='real' name='[Parameter 1109793234702345]' param-domain-type='any' role='measure' type='quantitative' value='1973.'>
              <calculation class='tableau' formula='1973.' />
            </column>
            <column caption='Starting War Year' datatype='real' default-format='N' name='[Parameter 5099988143046667]' param-domain-type='any' role='measure' type='quantitative' value='1941.'>
              <calculation class='tableau' formula='1941.' />
            </column>
            <column caption='War last Year' datatype='real' default-format='N' name='[Parameter 5099988143161356]' param-domain-type='any' role='measure' type='quantitative' value='1945.'>
              <calculation class='tableau' formula='1945.' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ib422m0y1w42f1228iq00oxiq4i'>
            <column caption='Vocalness' datatype='real' name='[Calculation_1109793230233602]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1 - [instrumentalness]' />
            </column>
